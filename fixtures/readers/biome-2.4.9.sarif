{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Biome",
          "informationUri": "https://biomejs.dev",
          "rules": [
            {
              "id": "format",
              "shortDescription": {
                "text": "Follow a consistent style—handling things like spacing, indentation, line breaks, and punctuation to make code easier to read and maintain."
              },
              "helpUri": "https://biomejs.dev/formatter/"
            },
            {
              "id": "lint/correctness/noUnusedVariables",
              "shortDescription": {
                "text": "Disallow unused variables."
              },
              "helpUri": "https://biomejs.dev/linter/rules/no-unused-variables"
            },
            {
              "id": "lint/suspicious/noDebugger",
              "shortDescription": {
                "text": "Disallow the use of `debugger`"
              },
              "helpUri": "https://biomejs.dev/linter/rules/no-debugger"
            },
            {
              "id": "lint/suspicious/noVar",
              "shortDescription": {
                "text": "Disallow the use of `var`"
              },
              "helpUri": "https://biomejs.dev/linter/rules/no-var"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "lint/suspicious/noDebugger",
          "level": "error",
          "message": {
            "text": "This is an unexpected use of the debugger statement."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/repo/apps/web/src/app/laptop/release-state.ts"
                },
                "region": {
                  "startLine": 56,
                  "startColumn": 1,
                  "endLine": 56,
                  "endColumn": 9
                }
              }
            }
          ]
        },
        {
          "ruleId": "lint/suspicious/noVar",
          "level": "error",
          "message": {
            "text": "Use let or const instead of var."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/repo/apps/web/src/app/laptop/release-state.ts"
                },
                "region": {
                  "startLine": 55,
                  "startColumn": 1,
                  "endLine": 55,
                  "endColumn": 24
                }
              }
            }
          ]
        },
        {
          "ruleId": "lint/correctness/noUnusedVariables",
          "level": "error",
          "message": {
            "text": "This variable unusedThing is unused."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/repo/apps/web/src/app/laptop/release-state.ts"
                },
                "region": {
                  "startLine": 55,
                  "startColumn": 6,
                  "endLine": 55,
                  "endColumn": 17
                }
              }
            }
          ]
        },
        {
          "ruleId": "format",
          "level": "error",
          "message": {
            "text": "Formatter would have printed the following content:"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/repo/apps/web/src/app/laptop/release-state.ts"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
