#!/bin/sh
# witness protocol-tier fake pi: records calls, answers canned NDJSON agent_end
# envelopes (the --mode json contract parsePiEnvelope consumes). Mirrors fakebin/claude.
set -e
if [ "$1" = "--version" ]; then echo "pi fake 0.0.0"; exit 0; fi
dir="${WITNESS_FAKE_DIR:?WITNESS_FAKE_DIR unset}"
# Claim the next number atomically, so lenses the gate launches together never share one. The
# claim is node's mkdir(2), never the mkdir UTILITY: uutils' mkdir (Ubuntu 26.04's default
# coreutils, 0.2.x) checks for the path, creates it, and reads an EEXIST it lost a race on as
# success, so on CI two concurrent calls each claimed call-2 and one call's record vanished.
# Every invocation also leaves its trail in pi-trace (one short line per append): start, each
# number already taken, its claim, its end. tests/helpers.ts checks the trail against the dirs.
trace="$dir/pi-trace"
mkdir -p "$dir/pi-calls"
echo "start $$" >> "$trace"
n=$(node -e '
  const fs = require("fs")
  const [calls, trace, pid] = process.argv.slice(1)
  for (let n = 1; ; n++) {
    try { fs.mkdirSync(`${calls}/call-${n}`); process.stdout.write(String(n)); break }
    catch (e) { if (e.code !== "EEXIST") throw e; fs.appendFileSync(trace, `taken ${pid} ${n}\n`) }
  }
' "$dir/pi-calls" "$trace" "$$")
echo "claim $$ $n" >> "$trace"
call="$dir/pi-calls/call-$n"
if [ -e ".witness/lock" ]; then echo held > "$call/lock"; else echo free > "$call/lock"; fi
printf '%s\n' "$@" > "$call/argv"
cat > "$call/stdin"
# the lens this call reviews for — witness exports WITNESS_LENS to every reviewer
lens="${WITNESS_LENS:-}"
if [ -n "$lens" ]; then printf '%s\n' "$lens" > "$call/lens"; fi
# the reviewer mark — witness exports WITNESS_REVIEWER=1 to every reviewer (row 191)
if [ -n "${WITNESS_REVIEWER:-}" ]; then printf '%s\n' "$WITNESS_REVIEWER" > "$call/reviewer"; fi
# barrier: hold until N calls exist — only a concurrent battery fills it
if [ -f "$dir/pi-barrier" ]; then
  want=$(cat "$dir/pi-barrier"); i=0
  while :; do
    have=0
    for d in "$dir"/pi-calls/call-*; do [ -e "$d" ] && have=$((have + 1)); done
    [ "$have" -ge "$want" ] && break
    i=$((i + 1))
    if [ "$i" -ge 50 ]; then echo "fake pi: barrier of $want not reached ($have in flight) · $(ls "$dir/pi-calls" | tr '\n' ' ')· $(tr '\n' ';' < "$trace")" >&2; exit 1; fi
    sleep 0.1
  done
fi
if [ -n "$lens" ] && [ -f "$dir/pi-delay-$lens" ]; then sleep "$(cat "$dir/pi-delay-$lens")"; fi
if [ -n "$lens" ] && [ -f "$dir/pi-fail-$lens" ]; then
  only=$(cat "$dir/pi-fail-$lens")
  if [ -z "$only" ] || grep -qF -- "$only" "$call/argv"; then
    echo "fake pi: injected failure for lens $lens" >&2
    exit 1
  fi
fi
if [ -f "$dir/pi-hang" ] && [ "$n" -le "$(cat "$dir/pi-hang")" ]; then
  sleep 30
fi
if [ -f "$dir/pi-fail" ] && [ "$n" -le "$(cat "$dir/pi-fail")" ]; then
  echo "fake pi: injected failure for call $n" >&2
  exit 1
fi
# pi-error: the in-stream provider-error shape (billing block) — exit 0, stopReason error.
# pi-error-calls limits it to the first N calls (a usage limit that lifts after a wait).
if [ -f "$dir/pi-error" ] && { [ ! -f "$dir/pi-error-calls" ] || [ "$n" -le "$(cat "$dir/pi-error-calls")" ]; }; then
  node -e '
    const fs = require("fs")
    const msg = fs.readFileSync(process.argv[1], "utf8").trim()
    const assistant = { role: "assistant", content: [], stopReason: "error", errorMessage: msg }
    process.stdout.write(JSON.stringify({ type: "agent_end", messages: [assistant] }) + "\n")
    process.stdout.write(JSON.stringify({ type: "agent_settled" }) + "\n")
  ' "$dir/pi-error"
  exit 0
fi
body="$dir/verdict.json"
if [ -n "$lens" ] && [ -f "$dir/verdict-$lens.json" ]; then body="$dir/verdict-$lens.json"; fi
[ -f "$dir/verdict-$n.json" ] && body="$dir/verdict-$n.json"
node -e '
  const fs = require("fs")
  const result = fs.readFileSync(process.argv[1], "utf8")
  const user = { role: "user", content: [{ type: "text", text: "" }] }
  const assistant = { role: "assistant", content: [{ type: "text", text: result }], stopReason: "stop" }
  process.stdout.write(JSON.stringify({ type: "turn_end", message: assistant }) + "\n")
  process.stdout.write(JSON.stringify({ type: "agent_end", messages: [user, assistant] }) + "\n")
  process.stdout.write(JSON.stringify({ type: "agent_settled" }) + "\n")
' "$body"
echo "end $$ $n" >> "$trace"
