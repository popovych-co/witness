#!/bin/sh
# witness protocol-tier fake claude: records calls, answers canned verdict envelopes.
set -e
if [ "$1" = "--version" ]; then echo "claude fake 0.0.0"; exit 0; fi
dir="${WITNESS_FAKE_DIR:?WITNESS_FAKE_DIR unset}"
mkdir -p "$dir/claude-calls"
n=0
for d in "$dir"/claude-calls/call-*; do [ -e "$d" ] && n=$((n + 1)); done
n=$((n + 1))
call="$dir/claude-calls/call-$n"
mkdir -p "$call"
# lock probe: records whether witness held its global lock while this reviewer ran.
# Sound because acquireLock refuses exactly when this file exists with a live pid
# (src/lock.ts:16-37) — "absent" therefore proves another flow's acquire would succeed.
# Gate runs have cwd = repo root (gate.ts:225 passes cwd: root), so the relative path
# resolves there. NOTE: calibrate.ts:143 invokes this same fakebin with cwd = a fixture
# dir, where the probe always reads `free`. No test may ever assert `held`.
if [ -e ".witness/lock" ]; then echo held > "$call/lock"; else echo free > "$call/lock"; fi
printf '%s\n' "$@" > "$call/argv"
cat > "$call/stdin"
# hang the first N calls past the caller's timeout — exercises transient-stall retry.
# The call is already recorded above, so the retry lands in call-$((n+1)).
if [ -f "$dir/claude-hang" ] && [ "$n" -le "$(cat "$dir/claude-hang")" ]; then
  sleep 30
fi
if [ -f "$dir/claude-fail" ] && [ "$n" -le "$(cat "$dir/claude-fail")" ]; then
  echo "fake claude: injected failure for call $n" >&2
  exit 1
fi
body="$dir/verdict.json"
[ -f "$dir/verdict-$n.json" ] && body="$dir/verdict-$n.json"
node -e '
  const fs = require("fs")
  const result = fs.readFileSync(process.argv[1], "utf8")
  process.stdout.write(JSON.stringify({ type: "result", subtype: "success", result }))
' "$body"
