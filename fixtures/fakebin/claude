#!/bin/sh
# witness protocol-tier fake claude: records calls, answers canned verdict envelopes.
set -e
if [ "$1" = "--version" ]; then echo "claude fake 0.0.0"; exit 0; fi
dir="${WITNESS_FAKE_DIR:?WITNESS_FAKE_DIR unset}"
# Claim the next number atomically, so lenses the gate launches together never share one. The
# claim is node's mkdir(2), never the mkdir UTILITY: uutils' mkdir (Ubuntu 26.04's default
# coreutils, 0.2.x) checks for the path, creates it, and reads an EEXIST it lost a race on as
# success, so on CI two concurrent calls each claimed call-2 and one call's record vanished.
# Every invocation also leaves its trail in claude-trace (one short line per append): start, each
# number already taken, its claim, its end. tests/helpers.ts checks the trail against the dirs.
trace="$dir/claude-trace"
mkdir -p "$dir/claude-calls"
echo "start $$" >> "$trace"
n=$(node -e '
  const fs = require("fs")
  const [calls, trace, pid] = process.argv.slice(1)
  for (let n = 1; ; n++) {
    try { fs.mkdirSync(`${calls}/call-${n}`); process.stdout.write(String(n)); break }
    catch (e) { if (e.code !== "EEXIST") throw e; fs.appendFileSync(trace, `taken ${pid} ${n}\n`) }
  }
' "$dir/claude-calls" "$trace" "$$")
echo "claim $$ $n" >> "$trace"
call="$dir/claude-calls/call-$n"
# lock probe: records whether witness held its global lock while this reviewer ran.
# Sound because acquireLock refuses exactly when this file exists with a live pid
# (src/lock.ts:16-37) — "absent" therefore proves another flow's acquire would succeed.
# Gate runs have cwd = repo root (gate.ts:225 passes cwd: root), so the relative path
# resolves there. A call whose cwd is not the repo root reads `free` whatever the lock.
# No test may ever assert `held`.
if [ -e ".witness/lock" ]; then echo held > "$call/lock"; else echo free > "$call/lock"; fi
printf '%s\n' "$@" > "$call/argv"
cat > "$call/stdin"
# the lens this call reviews for — witness exports WITNESS_LENS to every reviewer
lens="${WITNESS_LENS:-}"
if [ -n "$lens" ]; then printf '%s\n' "$lens" > "$call/lens"; fi
# the reviewer mark — witness exports WITNESS_REVIEWER=1 to every reviewer (row 191)
if [ -n "${WITNESS_REVIEWER:-}" ]; then printf '%s\n' "$WITNESS_REVIEWER" > "$call/reviewer"; fi
# barrier: hold until N calls exist — only a concurrent battery fills it
if [ -f "$dir/claude-barrier" ]; then
  want=$(cat "$dir/claude-barrier"); i=0
  while :; do
    have=0
    for d in "$dir"/claude-calls/call-*; do [ -e "$d" ] && have=$((have + 1)); done
    [ "$have" -ge "$want" ] && break
    i=$((i + 1))
    if [ "$i" -ge 50 ]; then echo "fake claude: barrier of $want not reached ($have in flight) · $(ls "$dir/claude-calls" | tr '\n' ' ')· $(tr '\n' ';' < "$trace")" >&2; exit 1; fi
    sleep 0.1
  done
fi
if [ -n "$lens" ] && [ -f "$dir/claude-delay-$lens" ]; then sleep "$(cat "$dir/claude-delay-$lens")"; fi
if [ -n "$lens" ] && [ -f "$dir/claude-fail-$lens" ]; then
  only=$(cat "$dir/claude-fail-$lens")
  if [ -z "$only" ] || grep -qF -- "$only" "$call/argv"; then
    echo "fake claude: injected failure for lens $lens" >&2
    exit 1
  fi
fi
# hang the first N calls past the caller's timeout — exercises transient-stall retry.
# The call is already recorded above, so the retry lands in call-$((n+1)).
if [ -f "$dir/claude-hang" ] && [ "$n" -le "$(cat "$dir/claude-hang")" ]; then
  sleep 30
fi
if [ -f "$dir/claude-fail" ] && [ "$n" -le "$(cat "$dir/claude-fail")" ]; then
  echo "fake claude: injected failure for call $n" >&2
  exit 1
fi
# claude-error: what claude 2.1.306's print mode does on a usage limit or any provider
# failure — an is_error result envelope on stdout, and exit 1. claude-error-calls limits it to
# the first N calls (a limit that lifts after a wait).
if [ -f "$dir/claude-error" ] && { [ ! -f "$dir/claude-error-calls" ] || [ "$n" -le "$(cat "$dir/claude-error-calls")" ]; }; then
  node -e '
    const fs = require("fs")
    const msg = fs.readFileSync(process.argv[1], "utf8").trim()
    process.stdout.write(JSON.stringify({ type: "result", subtype: "success", is_error: true, result: msg }))
  ' "$dir/claude-error"
  exit 1
fi
body="$dir/verdict.json"
if [ -n "$lens" ] && [ -f "$dir/verdict-$lens.json" ]; then body="$dir/verdict-$lens.json"; fi
[ -f "$dir/verdict-$n.json" ] && body="$dir/verdict-$n.json"
node -e '
  const fs = require("fs")
  const result = fs.readFileSync(process.argv[1], "utf8")
  process.stdout.write(JSON.stringify({ type: "result", subtype: "success", result }))
' "$body"
echo "end $$ $n" >> "$trace"
