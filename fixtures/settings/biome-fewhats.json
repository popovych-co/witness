{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["!docs", "!.witness", "!.pi", "!reports"]
  },
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "off",
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":URL:",
              ":NODE:",
              ":PACKAGE:",
              ":PACKAGE_WITH_PROTOCOL:",
              "@repo",
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": { "noMagicNumbers": "error" },
      "performance": { "noReExportAll": "error" }
    }
  },
  "overrides": [
    {
      "includes": ["packages/*/src/index.ts", "packages/*/src/index.tsx"],
      "linter": { "rules": { "performance": { "noBarrelFile": "off" } } }
    },
    {
      "includes": [
        "packages/*/src/*/index.ts",
        "packages/*/src/*/index.tsx",
        "packages/*/src/*/*/index.ts",
        "packages/*/src/*/*/index.tsx"
      ],
      "linter": { "rules": { "performance": { "noBarrelFile": "off" } } }
    },
    {
      "includes": [".agents/**", ".claude/skills/**"],
      "formatter": { "enabled": false },
      "linter": { "enabled": false },
      "assist": { "enabled": false }
    }
  ],
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/next",
    "ultracite/biome/react"
  ]
}
