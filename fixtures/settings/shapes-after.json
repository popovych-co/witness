{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.witness/hooks/guard-state.mjs\""
          }
        ]
      }
    ],
    "SessionStart": []
  },
  "permissions": {
    "allow": [
      "Bash(npx -y @popovych.co/witness*)",
      "Bash(witness *)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(git status)"
    ],
    "deny": [],
    "ask": ["Bash(rm:*)"]
  },
  "model": "opus",
  "env": {
    "A": "1"
  },
  "n": [1, 2, 3],
  "mixed": [1, "a", true, null],
  "empty": {},
  "nested": {
    "deep": {
      "list": [
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      ]
    }
  },
  "edge": ["xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"]
}
