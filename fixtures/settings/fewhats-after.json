{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-pnpm.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-dotenvx.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-biome.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.witness/hooks/guard-state.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.witness/hooks/guard-state.mjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.witness/hooks/session-dashboard.sh\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": ["Bash(npx -y @popovych.co/witness*)", "Bash(witness *)"]
  },
  "extraKnownMarketplaces": {
    "witness": {
      "source": {
        "source": "github",
        "repo": "popovych-co/witness"
      }
    }
  },
  "enabledPlugins": {
    "witness-context@witness": true
  }
}
