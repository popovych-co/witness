    "codegen",
    "ai-coding-assistant",
    "specs",
    "agent-skills"
  ],
  "homepage": "https://github.com/popovych-co/witness#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/popovych-co/witness.git"
  },
  "bugs": {
    "url": "https://github.com/popovych-co/witness/issues"
  },
  "author": "Kostiantyn Popovych",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
